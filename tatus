[32m+[m[32m│ (Write)      │     │ Primary (RW)     │     │ (RO)         │[m
[32m+[m[32m└─────────────┘     └──────────────────┘     └──────┬──────┘[m
[32m+[m[32m                                                     │[m
[32m+[m[32m                                              ┌──────▼──────┐[m
[32m+[m[32m                                              │ Query Side   │[m
